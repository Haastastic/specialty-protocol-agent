ANTHROPIC_API_KEY=your-key-here

# Required for src/voice_interface/media_stream_server.py against a live Twilio number.
# Not needed for scripts/simulate_call.py, which uses MockSTT/MockTTS instead.
DEEPGRAM_API_KEY=your-deepgram-key-here
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id-here

# Twilio account auth token — used to verify X-Twilio-Signature on /twiml and /media-stream.
# Required when the server is publicly reachable (e.g. Cloud Run). For local-only testing you
# can instead set TWILIO_SKIP_SIGNATURE_CHECK=1 (never set that on a public deployment).
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
